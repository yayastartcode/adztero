# Database
DATABASE_URL="file:./dev.db"

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
# Option 1: Single key
GEMINI_API_KEY="your-gemini-api-key-here"

# Option 2: Multiple keys for rotation (5x faster!)
# Comma-separated list of API keys - each gets 15 RPM = 75 RPM total with 5 keys
# GEMINI_API_KEYS="key1,key2,key3,key4,key5"

# Admin Authentication
# Generate password hash: npx tsx scripts/hash-password.ts yourpassword
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="your-bcrypt-hash-here"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Domain Configuration
BASE_DOMAIN="aksi.info"

# Server Configuration (for production deployment)
NGINX_SITES_AVAILABLE="/etc/nginx/sites-available"
NGINX_SITES_ENABLED="/etc/nginx/sites-enabled"
STATIC_SITES_PATH="/var/www/sites"

# Rate Limiting
# With 1 key: use 15 for max speed
# With 5 keys: use 75 (5 × 15 RPM)
GEMINI_RPM=15
KEYWORD_BATCH_SIZE=500
